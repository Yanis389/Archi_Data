<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!-- TP J2 - Retail Intelligence Platform : HDFS pseudo-distribué (section 1.4 du sujet).
     ETUDIANT remplacé par le compte Linux réel du conteneur : etudiant.
     Facteur de réplication 1 : un seul DataNode, une deuxième copie serait impossible à placer. -->
<configuration>
  <property>
    <name>dfs.replication</name>
    <value>1</value>
  </property>
  <property>
    <name>dfs.namenode.name.dir</name>
    <value>file:///home/etudiant/hadoop-data/namenode</value>
  </property>
  <property>
    <name>dfs.datanode.data.dir</name>
    <value>file:///home/etudiant/hadoop-data/datanode</value>
  </property>
</configuration>
